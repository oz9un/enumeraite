# Export these variables, or copy to .env and source that file in your shell.
# Enumeraite does not load .env automatically. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Optional shared generation controls.
ENUMERAITE_CONFIDENCE=model
ENUMERAITE_CONTEXT=true
ENUMERAITE_HYBRID=true
ENUMERAITE_TEMPERATURE=0.7
ENUMERAITE_BATCH_SIZE=20
ENUMERAITE_MAX_BATCH_CALLS=3
ENUMERAITE_PROVIDER_TIMEOUT=180
ENUMERAITE_HYBRID_MODEL_FRACTION=0.5
ENUMERAITE_SEED_LIMIT=500
ENUMERAITE_SEED_CHAR_LIMIT=50000

# HTTP validation and per-prefix soft-404 calibration.
ENUMERAITE_HTTP_VERIFY_SSL=true
ENUMERAITE_HTTP_SOFT_404_THRESHOLD=0.92
ENUMERAITE_HTTP_BASELINE_SAMPLES=2
ENUMERAITE_HTTP_BASELINE_DEPTH=1
ENUMERAITE_HTTP_MAX_BASELINE_GROUPS=32

# Opt in only for a model repository whose code you have reviewed.
HUGGINGFACE_TRUST_REMOTE_CODE=false
# Required for custom Hugging Face models; use a full immutable commit SHA.
HUGGINGFACE_REVISION=
